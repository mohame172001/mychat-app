# ============================================================
# mychat backend — environment variables
# Copy to .env and fill in. Anything marked REQUIRED IN PRODUCTION
# refuses to start without a real value.
# ============================================================

# --- Database ------------------------------------------------
MONGO_URL="mongodb://localhost:27017"
DB_NAME="mychat_db"

# --- Meta / Instagram OAuth ----------------------------------
# Get from https://developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=mychat_verify_123
# REQUIRED IN PRODUCTION — verifies the X-Hub-Signature-256 header
# on every Instagram webhook. Falls back to META_APP_SECRET if unset.
# META_WEBHOOK_APP_SECRET=
# Set META_WEBHOOK_HMAC_ENFORCE=0 only for local testing; production
# refuses to start with this off.
# META_WEBHOOK_HMAC_ENFORCE=1

# --- JWT signing ---------------------------------------------
# REQUIRED. Generate with: openssl rand -hex 32
# Production startup refuses any value shorter than 32 chars.
JWT_SECRET=change_me_to_random_32_byte_hex

# --- Google Sign-In (optional) -------------------------------
# Google Cloud OAuth web client ID. Leave blank to disable the
# "Continue with Google" button on /login and /signup.
GOOGLE_CLIENT_ID=

# --- Cron tasks ----------------------------------------------
# Shared secret for POST /api/cron/refresh-instagram-tokens.
# Generate with: openssl rand -hex 24
CRON_SECRET=change_me_to_random_cron_secret

# --- Public URLs (used in OAuth redirects + email links) -----
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8001

# --- CORS ----------------------------------------------------
# Comma-separated explicit allowed origins for production.
# FRONTEND_URL and RAILWAY_PUBLIC_DOMAINS are added automatically.
CORS_ALLOWED_ORIGINS=

# --- Email delivery (optional) -------------------------------
# Webhook the backend POSTs to for verification + password-reset
# mails. Without it, accounts can be created but the user never
# receives the activation link.
EMAIL_VERIFICATION_WEBHOOK_URL=
EMAIL_VERIFICATION_WEBHOOK_TOKEN=

# --- Admin allowlist (optional) ------------------------------
# Comma-separated emails granted operator-level admin access
# regardless of DB role rows. Leave empty in normal SaaS deploys.
ADMIN_EMAILS=

# --- Repair tools toggle (optional) --------------------------
# Set to "true" only during a repair window. Off by default so the
# /admin/comments/* endpoints stay locked.
ENABLE_ADMIN_REPAIR_TOOLS=false

# --- Hardening knobs (optional) ------------------------------
# Per-request body cap. Defaults to 2 MB. Bigger values increase
# memory pressure under load.
REQUEST_BODY_MAX_BYTES=2097152

# --- Rate-limit thresholds (optional, sensible defaults) -----
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_SIGNUP_PER_HOUR=5
# RATE_LIMIT_POLL_NOW_PER_MIN=5
# RATE_LIMIT_INSTAGRAM_CONNECT_PER_MIN=5
# RATE_LIMIT_DATA_DELETION_PER_HOUR=20

# --- Observability (optional) --------------------------------
# Sentry DSN for backend errors. Without it, errors are still
# logged but not forwarded.
SENTRY_DSN=
APP_ENV=development
