modules = ["python-3.12", "nodejs-20", "web"]

# Replit runs the existing API service as the web process. The frontend is
# built separately and points to the deployed API through REACT_APP_BACKEND_URL.
run = "cd backend && uvicorn server:app --host 0.0.0.0 --port 8000"

[deployment]
run = ["sh", "-c", "cd backend && uvicorn server:app --host 0.0.0.0 --port $PORT"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true
