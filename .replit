modules = ["python-3.12", "nodejs-20", "web"]

# Replit serves the built React app and API from one web process.
run = "yarn --cwd frontend install --frozen-lockfile && yarn --cwd frontend build && cd backend && uvicorn server:app --host 0.0.0.0 --port 8000"

[deployment]
run = ["sh", "-c", "yarn --cwd frontend install --frozen-lockfile && yarn --cwd frontend build && cd backend && uvicorn server:app --host 0.0.0.0 --port $PORT"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true
